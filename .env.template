# ================== API Keys ==================
# Anthropic API Key (or proxy)
ANTHROPIC_API_KEY=sk-your-key-here
# OpenAI API Key (or proxy)
OPENAI_API_KEY=sk-your-key-here

# GLM API Key (Zhipu AI) - Anthropic protocol
ZAI_API_KEY=your-zai-key-here
ZAI_API_BASE=https://open.bigmodel.cn/api/anthropic

# MiniMax API - Anthropic-compatible endpoint
MINIMAX_API_KEY=your-minimax-key-here
MINIMAX_API_BASE=https://api.minimaxi.com/anthropic

# Kimi API - Anthropic-compatible endpoint
KIMI_API_KEY=your-kimi-key-here
KIMI_API_BASE=https://api.kimi.com/coding/

# ================== API Base URLs ==================
# Proxy endpoint (multi-domain auto-switch)
ANTHROPIC_API_BASE=https://your-proxy.example.com
OPENAI_API_BASE=https://your-proxy.example.com/v1

# ================== Model Configuration ==================
# Tier assignment
NADIRCLAW_SIMPLE_MODEL=glm-5.1
NADIRCLAW_COMPLEX_MODEL=claude-sonnet-4-6
NADIRCLAW_EXPLORE_MODEL=glm-5.1
NADIRCLAW_REASONING_MODEL=claude-opus-4-7
NADIRCLAW_SUBAGENT_MODEL=glm-5.1
NADIRCLAW_EXECUTION_MODEL=glm-5.1
NADIRCLAW_FREE_MODEL=hosted_vllm/your-local-model
NADIRCLAW_REVIEW_MODEL=gpt-5.4
NADIRCLAW_LONG_CONTEXT_MODEL=claude-opus-4-7

# ================== Fallback Chains ==================
NADIRCLAW_FALLBACK_CHAIN=claude-opus-4-7,claude-sonnet-4-6,gpt-5.4,glm-5.1,glm-5-turbo,kimi-K2.6-code-preview,minimax-MiniMax-M2.7,hosted_vllm/your-local-model

# Per-tier fallbacks
NADIRCLAW_REASONING_FALLBACK=claude-sonnet-4-6,gpt-5.4,glm-5.1,glm-5-turbo,kimi-K2.6-code-preview,minimax-MiniMax-M2.7,hosted_vllm/your-local-model
NADIRCLAW_COMPLEX_FALLBACK=gpt-5.4,glm-5.1,glm-5-turbo,kimi-K2.6-code-preview,minimax-MiniMax-M2.7,hosted_vllm/your-local-model
NADIRCLAW_EXECUTION_FALLBACK=glm-5.1,glm-5-turbo,kimi-K2.6-code-preview,minimax-MiniMax-M2.7,hosted_vllm/your-local-model
NADIRCLAW_SUBAGENT_FALLBACK=glm-5.1,glm-5-turbo,kimi-K2.6-code-preview,minimax-MiniMax-M2.7,hosted_vllm/your-local-model
NADIRCLAW_EXPLORE_FALLBACK=glm-5.1,glm-5-turbo,kimi-K2.6-code-preview,minimax-MiniMax-M2.7,hosted_vllm/your-local-model
NADIRCLAW_SIMPLE_FALLBACK=glm-5-turbo,kimi-K2.6-code-preview,minimax-MiniMax-M2.7,hosted_vllm/your-local-model
NADIRCLAW_LONG_CONTEXT_FALLBACK=claude-sonnet-4-6,gpt-5.4,glm-5.1,glm-5-turbo,hosted_vllm/your-local-model

# ================== Local vLLM ==================
HOSTED_VLLM_API_BASE=http://localhost:8000/v1
HOSTED_VLLM_API_KEY=none

# ================== Model Pools ==================
NADIRCLAW_MODEL_POOL_ENABLED=true
# Format: pool_name=model,weight+model,weight;pool_name=model,weight+model,weight
NADIRCLAW_MODEL_POOLS=turbo=glm-5-turbo,10+kimi-K2.6-code-preview,9+minimax-MiniMax-M2.7,3;reasoning=gpt-5.4,5+glm-5.1,5

# ================== Tuning ==================
NADIRCLAW_PORT=8856
NADIRCLAW_REQUEST_TIMEOUT=600
NADIRCLAW_CONFIDENCE_THRESHOLD=0.01
NADIRCLAW_COMPLEX_THRESHOLD=0.70

# Context compression (dedup + summarize old turns)
NADIRCLAW_CONTEXT_COMPRESSION=true
NADIRCLAW_COMPRESS_MIN_MESSAGES=30
NADIRCLAW_COMPRESS_RECENT_WINDOW=20
NADIRCLAW_COMPRESS_TOOL_MAX=500

# Rate limits (RPM per model)
NADIRCLAW_MODEL_RATE_LIMITS=
NADIRCLAW_DEFAULT_MODEL_RPM=120

# Domain cooldown after 429 (seconds)
NADIRCLAW_DOMAIN_COOLDOWN=180

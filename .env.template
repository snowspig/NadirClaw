# ================== API Keys ==================
# Anthropic API Key (or proxy)
ANTHROPIC_API_KEY=sk-your-key-here
# OpenAI API Key (or proxy)
OPENAI_API_KEY=sk-your-key-here

# GLM API Key (Zhipu AI) - Anthropic protocol
ZAI_API_KEY=your-zai-key-here
ZAI_API_BASE=https://open.bigmodel.cn/api/anthropic

# MiniMax API - Anthropic-compatible endpoint
MINIMAX_API_KEY=your-minimax-key-here
MINIMAX_API_BASE=https://api.minimaxi.com/anthropic

# Kimi API - Anthropic-compatible endpoint
KIMI_API_KEY=your-kimi-key-here
KIMI_API_BASE=https://api.kimi.com/coding

# ================== Proxy & Domain Failover ==================
# Multi-domain proxy: NadirClaw picks the healthiest domain per request.
# When one domain returns 429/5xx/timeout, it cools down and the other takes over.
# Comma-separated list — add all your proxy domains for maximum reliability.
ANTHROPIC_API_BASE=https://your-proxy-1.example.com
OPENAI_API_BASE=https://your-proxy-1.example.com/v1
NADIRCLAW_PPCHAT_DOMAINS=your-proxy-1.example.com,your-proxy-2.example.com

# ================== Model Configuration ==================
# 9-tier routing strategy:
#   Reasoning/Long Context: Opus (primary) → Sonnet → pool-reasoning → pool-turbo
#   Simple/Complex/Execution/Subagent/Explore: glm-5.1 → pool-turbo
#   Review: gpt-5.5
NADIRCLAW_SIMPLE_MODEL=glm-5.1
NADIRCLAW_COMPLEX_MODEL=claude-sonnet-4-6
NADIRCLAW_EXPLORE_MODEL=glm-5.1
NADIRCLAW_REASONING_MODEL=claude-opus-4-7
NADIRCLAW_SUBAGENT_MODEL=kimi-for-coding
NADIRCLAW_EXECUTION_MODEL=glm-5.1
NADIRCLAW_FREE_MODEL=hosted_vllm/your-local-model
NADIRCLAW_REVIEW_MODEL=gpt-5.5
NADIRCLAW_LONG_CONTEXT_MODEL=glm-5.1

# ================== Fallback Chains ==================
# Main chain: tried in order when a model fails
NADIRCLAW_FALLBACK_CHAIN=gpt-5.5,claude-opus-4-7,claude-sonnet-4-6,glm-5.1,gpt-5.4,glm-5-turbo,kimi-for-coding,minimax-MiniMax-M2.7,hosted_vllm/your-local-model

# Per-tier fallback chains
NADIRCLAW_REASONING_FALLBACK=claude-sonnet-4-6,glm-5.1,glm-5-turbo,kimi-for-coding,minimax-MiniMax-M2.7
NADIRCLAW_COMPLEX_FALLBACK=gpt-5.5,glm-5.1,glm-5-turbo,kimi-for-coding,minimax-MiniMax-M2.7
NADIRCLAW_EXECUTION_FALLBACK=glm-5.1,glm-5-turbo,kimi-for-coding,minimax-MiniMax-M2.7
NADIRCLAW_SUBAGENT_FALLBACK=glm-5.1,glm-5-turbo,minimax-MiniMax-M2.7
NADIRCLAW_EXPLORE_FALLBACK=glm-5.1,glm-5-turbo,kimi-for-coding,minimax-MiniMax-M2.7
NADIRCLAW_REVIEW_FALLBACK=gpt-5.5,glm-5.1,glm-5-turbo,kimi-for-coding,minimax-MiniMax-M2.7
NADIRCLAW_SIMPLE_FALLBACK=glm-5-turbo,kimi-for-coding,minimax-MiniMax-M2.7,hosted_vllm/your-local-model
NADIRCLAW_LONG_CONTEXT_FALLBACK=glm-5.1,glm-5-turbo,gpt-5.5,kimi-for-coding,minimax-MiniMax-M2.7

# ================== Local vLLM ==================
HOSTED_VLLM_API_BASE=http://localhost:8000/v1
HOSTED_VLLM_API_KEY=none

# ================== Model Pools ==================
NADIRCLAW_MODEL_POOL_ENABLED=true
# Format: pool_name=model,weight+model,weight
NADIRCLAW_MODEL_POOLS=turbo=glm-5-turbo,10+kimi-for-coding,9+minimax-MiniMax-M2.7,3

# ================== Tuning ==================
NADIRCLAW_PORT=8856
NADIRCLAW_REQUEST_TIMEOUT=600
NADIRCLAW_CONFIDENCE_THRESHOLD=0.01
NADIRCLAW_COMPLEX_THRESHOLD=0.50

# ================== Context Compression ==================
# Dedup + summarize old turns to stay within context limits
NADIRCLAW_CONTEXT_COMPRESSION=true
NADIRCLAW_COMPRESS_MIN_MESSAGES=30
NADIRCLAW_COMPRESS_RECENT_WINDOW=20
NADIRCLAW_COMPRESS_TOOL_MAX=500
NADIRCLAW_COMPRESS_VLLM_SUMMARY=false
NADIRCLAW_COMPRESS_VLLM_URL=http://localhost:8000/v1/chat/completions
NADIRCLAW_COMPRESS_VLLM_MODEL=your-local-model

# LLM-based compression for very long contexts
NADIRCLAW_COMPRESS_LLM_SUMMARY=true
NADIRCLAW_COMPRESS_LLM_MODELS=glm-5.1,gpt-5.5
NADIRCLAW_COMPRESS_LLM_TRIGGER_TOKENS=100000
NADIRCLAW_COMPRESS_LLM_TARGET_TOKENS=50000
NADIRCLAW_COMPRESS_LLM_MAX_SOURCE_CHARS=200000
NADIRCLAW_COMPRESS_SUMMARY_MAX_TOKENS=50000
NADIRCLAW_COMPRESS_HEAD_MESSAGES=8
NADIRCLAW_COMPRESS_TAIL_TOKENS=30000
NADIRCLAW_COMPRESS_MIDDLE_TRIGGER_TOKENS=90000
NADIRCLAW_COMPRESS_SUMMARY_MAX_CHARS=200000

# ================== Long / Huge Context ==================
NADIRCLAW_LONG_CONTEXT_THRESHOLD=90000
NADIRCLAW_HUGE_CONTEXT_MODEL=kimi-for-coding
NADIRCLAW_HUGE_CONTEXT_THRESHOLD=180000
NADIRCLAW_HUGE_CONTEXT_FALLBACK=kimi-for-coding,gpt-5.5,gemini-3.1-pro,glm-5.1,glm-5-turbo,minimax-MiniMax-M2.7

# Auto-reroute compressed Opus sessions to cheaper models
NADIRCLAW_COMPRESSED_OPUS_REROUTE=true
NADIRCLAW_COMPRESSED_OPUS_THRESHOLD=100000
NADIRCLAW_COMPRESS_OPUS_SAFETY_TOKENS=5000

# ================== Rate Limits ==================
# Per-model RPM limits (0 = unlimited, rely on upstream 429)
# GLM: 5-hour windows, ~5000 requests each → ~15 RPM safe limit
NADIRCLAW_MODEL_RATE_LIMITS=glm-5.1=15,glm-5-turbo=15,glm-4.7=15,glm-4.7-flash=15,minimax-MiniMax-M2.7=10,kimi-for-coding=30
NADIRCLAW_DEFAULT_MODEL_RPM=0

# ================== Domain Health ==================
# Cooldown after 429 (seconds) — proxy needs time to recover
NADIRCLAW_DOMAIN_COOLDOWN=180
# Health probe interval (seconds)
NADIRCLAW_DOMAIN_PROBE_INTERVAL=86400

# ================== Protocol Compatibility ==================
# Convert OpenAI-format responses to Anthropic format for Claude Code
NADIRCLAW_OPENAI_TO_ANTHROPIC_COMPAT=true
# Fix for OpenClash fake-ip: disable aiohttp transport, use pure httpx
DISABLE_AIOHTTP_TRANSPORT=True
